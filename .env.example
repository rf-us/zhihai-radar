# radar 服务配置模板（公网 Demo / 本地演示通用）
# 复制为 .env 后按需修改；不要把真实凭证提交到仓库。

# 监听地址（只暴露这一个端口；RFERP 仅 127.0.0.1，不对外）
RADAR_ADDR=:8090

# 数据目录（radar 自有 SQLite 与缓存；删掉不影响 RFERP）
RADAR_DATA_DIR=./data

# 数据源模式：fixture（离线快照，Demo 默认）| zhihu（真实接口）
# 公网 Demo 必须用 fixture，避免被扫把热榜/直答配额烧完。
RADAR_SOURCE=fixture
RADAR_FIXTURE_DIR=./fixtures

# 知乎 Access Secret（仅 RADAR_SOURCE=zhihu 时需要；只从环境变量读）
# ZHIHU_ACCESS_SECRET=

# 运行环境托管：radar 拉起 RFERP 并自动发现主机指纹
REEF_MANAGED=1
REEF_BIN=./rferp-server.exe
REEF_PORT=8080
# 外部已有 RFERP 时改用下面两行，并设 REEF_MANAGED=0
# REEF_MANAGED=0
# REEF_BASE=http://127.0.0.1:8080
# REEF_DEVICE_ID=

# 只读演示账号开关（1=禁止采纳写回，评委账号可临时关闭）
RADAR_READONLY=0

# 知乎 OAuth（可选，三项都配齐才启用；未配置时前端入口自动隐藏）
# App ID / App Key 在赛事项目创建后由官方页面分配
# ZHIHU_OAUTH_APP_ID=
# ZHIHU_OAUTH_APP_KEY=
# ZHIHU_OAUTH_REDIRECT_URI=https://your-domain/api/auth/zhihu/callback
